# VolaCast Configuration (.env.example)
# Copy this file to .env and update values for your environment.
# No secrets or API keys are hardcoded; all configuration is environment-driven.

# Application Settings
APP_NAME=VolaCast
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
# Supported formats:
#   - SQLite: sqlite:///./volatility.db
#   - PostgreSQL: postgresql://user:password@localhost:5432/volatility
#   - MySQL: mysql+pymysql://user:password@localhost:3306/volatility
DATABASE_URL=sqlite:///./volatility.db

# Security
# Generate a strong secret key for admin operations (use `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
ADMIN_SECRET_KEY=your_admin_secret_key_here_change_in_production

# Caching & Expiry
# TTL for cached forecasts in hours (1-168)
DEFAULT_CACHE_HOURS=6

# Model Configuration
# Maximum number of days to forecast (1-90)
MAX_FORECAST_HORIZON=10

# Minimum historical data points required for model fitting (~2 years of daily data)
MIN_DATA_POINTS=504

# API Key Management
# Maximum age of API keys before expiry (30-1095 days)
MAX_API_KEY_AGE_DAYS=365

# Observability (Optional)
# Sentry error tracking DSN (leave empty to disable)
SENTRY_DSN=

# Data Source Configuration (Optional)
# Alpha Vantage API key for fallback data fetching (leave empty to use only yfinance)
ALPHA_VANTAGE_KEY=

